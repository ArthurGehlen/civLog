# Copie este arquivo para .env.local e preencha com seus valores.
# Todas as variáveis são NEXT_PUBLIC_* (lidas no navegador).

# Supabase (Auth + Banco + Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile (captcha em login/signup/forgot-password)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudinary (upload de avatar)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
